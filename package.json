{
  "name": "aria2-bridge",
  "version": "1.5.0",
  "private": true,
  "description": "Aria2 Bridge — Chrome extension that forwards browser downloads to aria2",
  "scripts": {
    "test": "playwright test tests/",
    "test:ui": "playwright test --ui tests/",
    "pretest": "npm run check:i18n",
    "check:i18n": "node scripts/check-i18n.mjs",
    "lint": "eslint plugin/ tests/ scripts/ playwright.config.js",
    "lint:fix": "eslint plugin/ tests/ scripts/ playwright.config.js --fix",
    "format": "prettier --write \"plugin/*.js\" \"plugin/js/*.js\" \"plugin/lib/*.js\" \"tests/*.mjs\" \"tests/*.js\" \"scripts/*.mjs\" \"playwright.config.js\"",
    "format:check": "prettier --check \"plugin/*.js\" \"plugin/js/*.js\" \"plugin/lib/*.js\" \"tests/*.mjs\" \"tests/*.js\" \"scripts/*.mjs\" \"playwright.config.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6"
  }
}
