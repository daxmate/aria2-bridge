{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.5.1",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "notifications",
    "cookies",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/i18n.js",
        "vendor/sweetalert2/sweetalert2.all.min.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "__MSG_extDefaultTitle__"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
